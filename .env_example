# ============================================================
# L-RAG Environment Variables — Example
# ============================================================
# Copy this file to .env and fill in your actual values.
# .env is git-ignored — never commit real API keys.

# --- DeepSeek API (LLM provider) ---
# DeepSeek V4 Flash (cost-saving default, ~3x cheaper than V4 Pro) via
# OpenAI-compatible API. Set DEEPSEEK_MODEL=deepseek-v4-pro for max quality.
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --- LLM Provider Selection ---
# Set to "deepseek" to use DeepSeek API, or "local" (default) for Qwen/Ollama.
# Can also be overridden via CLI: --provider deepseek
LLM_PROVIDER=local

# --- Local LLM (Qwen via Ollama/vLLM) — used when LLM_PROVIDER=local ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:14b
